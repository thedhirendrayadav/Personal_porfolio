# Local Flask settings. Use unique values and keep .env out of Git.
SECRET_KEY=replace-with-a-random-local-secret
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-unique-local-password

# Set DATABASE_TYPE=mysql for local MySQL, or supabase to use Supabase.
DATABASE_TYPE=mysql

# Supabase backend credentials (required when DATABASE_TYPE=supabase).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional contact form email notifications.
MAIL_USERNAME=
MAIL_PASSWORD=
RECEIVER_EMAIL=
